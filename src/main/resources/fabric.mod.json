{
  "schemaVersion": 1,
  "id": "mcvmcomputers",
  "version": "${version}",
  "name": "VM Computers (86Box)",
  "description": "Build working retro PCs in Minecraft, emulated by 86Box. Fork of VM Computers by DeltaTwoForce, with VirtualBox replaced by the latest 86Box builds.",
  "authors": [
    "DeltaTwoForce (original mod)",
    "Dank (86Box edition)"
  ],
  "contact": {
    "original": "https://github.com/Delta2Force/MCVmComputers"
  },
  "license": "GPL-3.0-or-later",
  "icon": "assets/mcvmcomputers/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mcvmcomputers.MainMod"
    ],
    "client": [
      "mcvmcomputers.client.ClientMod"
    ]
  },
  "mixins": [
    "mcvmcomputers.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.14.21",
    "fabric-api": "*",
    "minecraft": "~1.20.1",
    "java": ">=17"
  }
}
